# Call-to-Action Configurations
# Set to 'false' to deactivate the floating 'Tap to Call / WhatsApp' CTA bubble globally
NEXT_PUBLIC_SHOW_CTA_BUBBLE=false

# Primary business phone number (default fallback: "07742 831011")
NEXT_PUBLIC_PHONE_NUMBER=

# Google Ads Conversion / Tag Tracking (only loads in production)
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_TAG_PATH=/oojo
NEXT_PUBLIC_GOOGLE_ADS_CALL_CONVERSION_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_WHATSAPP_CONVERSION_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_FORM_CONVERSION_LABEL=

# Resend Email Service Configuration
RESEND_API_KEY=
CONTACT_RECEIVER_EMAIL=
CONTACT_SENDER_EMAIL=